<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: DejaVu Sans, sans-serif; font-size: 12px; color:#111; }
    h2 { margin: 0 0 6px; }
    .muted { color:#666; margin-bottom: 14px; }
    table { width:100%; border-collapse: collapse; margin-bottom: 18px; }
    th, td { border:1px solid #ddd; padding:8px; }
    th { background:#f5f6f8; text-align:left; }
  </style>
</head>
<body>
  <h2>Stock Report</h2>
  <div class="muted">Generated: {{ generatedAt|date('Y-m-d H:i') }}</div>

  <h3>Low Stock (1–3)</h3>
  <table>
    <thead>
      <tr><th>Name</th><th>Category</th><th>Supplier</th><th>Qty</th><th>Price</th></tr>
    </thead>
    <tbody>
      {% for p in lowStock %}
        <tr>
          <td>{{ p.name }}</td>
          <td>{{ p.category }}</td>
          <td>{{ p.supplier ? p.supplier.name : '' }}</td>
          <td>{{ p.quantity }}</td>
          <td>{{ p.price }}</td>
        </tr>
      {% else %}
        <tr><td colspan="5">No low stock products.</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <h3>Out of Stock (0)</h3>
  <table>
    <thead>
      <tr><th>Name</th><th>Category</th><th>Supplier</th><th>Price</th></tr>
    </thead>
    <tbody>
      {% for p in outOfStock %}
        <tr>
          <td>{{ p.name }}</td>
          <td>{{ p.category }}</td>
          <td>{{ p.supplier ? p.supplier.name : '' }}</td>
          <td>{{ p.price }}</td>
        </tr>
      {% else %}
        <tr><td colspan="4">No out of stock products.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
