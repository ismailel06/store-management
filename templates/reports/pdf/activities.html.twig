<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: DejaVu Sans, sans-serif; font-size: 12px; color:#111; }
    h2 { margin: 0 0 6px; }
    .muted { color:#666; margin-bottom: 14px; }
    table { width:100%; border-collapse: collapse; margin-bottom: 18px; }
    th, td { border:1px solid #ddd; padding:8px; }
    th { background:#f5f6f8; text-align:left; }
  </style>
</head>
<body>
  <h2>Activities Report (Last 7 days)</h2>
  <div class="muted">Generated: {{ generatedAt|date('Y-m-d H:i') }}</div>

  <h3>Supply Requests</h3>
  <table>
    <thead>
      <tr><th>Product</th><th>Supplier</th><th>Status</th><th>Requested</th><th>Updated</th></tr>
    </thead>
    <tbody>
      {% for r in recentSupply %}
        <tr>
          <td>{{ r.product ? r.product.name : '' }}</td>
          <td>{{ r.supplier ? r.supplier.name : '' }}</td>
          <td>{{ r.status }}</td>
          <td>{{ r.createdAt ? r.createdAt|date('Y-m-d H:i') : '' }}</td>
          <td>{{ r.updatedAt ? r.updatedAt|date('Y-m-d H:i') : '' }}</td>
        </tr>
      {% else %}
        <tr><td colspan="5">No supply activity.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</body>
</html>
