<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Stock Dashboard{% endblock %}</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Lobster+Two&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;700&family=Rubik+Gemstones&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>

<div class="d-flex" id="dashboard">

    <!-- Sidebar -->
    <aside class="sidebar p-3">
        <h3 class="text-white mb-4"><i class="bi bi-bag-check-fill"></i> FlowVentory</h3>
        <ul class="nav flex-column" >
        {% if is_granted('ROLE_ADMIN') %}
            <li class="nav-item"><a href="{{ path('dashboard') }}" class="nav-link-custom {% if app.request.attributes.get('_route') == 'dashboard' %}active{% endif %}"><i class="bi bi-house-fill me-2"></i> Dashboard</a></li>
            <li class="nav-item"><a href="{{ path('app_product_index') }}"  class="nav-link-custom {% if app.request.attributes.get('_route') == 'app_product_index' %}active{% endif %}"><i class="bi bi-box-seam me-2"></i> Products</a></li>
            <li class="nav-item"><a href="{{ path('app_stock_index') }}"  class="nav-link-custom {% if app.request.attributes.get('_route') == 'app_stock_index' %}active{% endif %}"><i class="bi bi-stack me-2"></i> Stock</a></li>
            <li class="nav-item"><a href="{{ path('app_supplier_index') }}"  class="nav-link-custom {% if app.request.attributes.get('_route') == 'app_supplier_index' %}active{% endif %}"><i class="bi bi-people-fill me-2"></i> Suppliers</a></li>
            <li class="nav-item"><a href="{{ path('app_reports_index') }}"  class="nav-link-custom {% if app.request.attributes.get('_route') == 'app_reports_index' %}active{% endif %}"><i class="bi bi-bar-chart-line-fill me-2"></i> Reports</a></li>
            <hr class="text-white">
        {% endif %}

        {% if is_granted('ROLE_USER') %}
            <li class="nav-item"><a href="{{ path('app_shop_index') }}"  class="nav-link-custom {% if app.request.attributes.get('_route') == 'app_shop_index' %}active{% endif %}"><i class="bi bi-shop me-2"></i> Store</a></li>
            <li class="nav-item"><a href="{{ path('app_cart_index') }}"  class="nav-link-custom {% if app.request.attributes.get('_route') == 'app_cart_index' %}active{% endif %}"><i class="bi bi-cart me-2"></i> Cart</a></li>
        {% endif %}
        </ul>
    </aside>

    <!-- Main content -->
    <div class="flex-grow-1 main-content bg-white">

        <!-- Top Navbar -->
        <nav class="topbar navbar navbar-light bg-light border-bottom px-4">
            <span class="fs-4"> {{pageTitle | default('FlowVentory')}} </span>
            <div class="d-flex gap-5">
                {% if is_granted('ROLE_ADMIN') %}
                    {{ render(controller('App\\Controller\\TopbarBellController::bell')) }}
                {% endif %}
                <div class="dropdown">
                    <button class="btn p-0 border-0 bg-transparent" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle fs-5" id="profile"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm profile-dropdown">
                        {% if app.user %}
                        <li class="px-3 py-2">
                            <div class="text-muted small">Signed in as</div>
                            <div class="fw-semibold">{{ app.user.userIdentifier }}</div>
                        </li>
                        <li><hr class="dropdown-divider"></li>

                        {# Optional: add a "My Orders" link if you have it #}
                        {# <li><a class="dropdown-item" href="{{ path('app_orders_my') }}"><i class="bi bi-receipt me-2"></i>My orders</a></li> #}

                        <li>
                            <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                            <i class="fa-solid fa-right-from-bracket me-2"></i> Logout
                            </a>
                        </li>
                        {% else %}
                        <li class="px-3 py-2">
                            <div class="fw-semibold">Welcome</div>
                            <div class="text-muted small">Sign in to continue</div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_login') }}">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Login
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_register') }}">
                            <i class="bi bi-person-plus me-2"></i> Register
                            </a>
                        </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Page content -->
        <main class="p-4">
            {% block body %}{% endblock %}
        </main>
    </div>
</div>

<footer class="footer">
    <div class="footer-container">
        <div class="footer-section brand">
        <h3 class="text-white mb-4"><i class="bi bi-bag-check-fill"></i> FlowVentory</h3>
        <p>Manage your store efficiently and smartly.</p>
        </div>

        <div class="footer-section links">
        <h4>Quick Links</h4>
        <ul>

            {% if is_granted('ROLE_ADMIN') %}
                <li><a href="{{ path('dashboard') }}">Dashboard</a></li>
                <li><a href="{{ path('app_product_index') }}">Products</a></li>
                <li><a href="{{ path('app_stock_index') }}">Stock</a></li>
                <li><a href="{{ path('app_supplier_index') }}">Suppliers</a></li>
                <li><a href="{{ path('app_reports_index') }}">Reports</a></li>
            {% endif %}

            {% if is_granted('ROLE_USER') %}
                <li><a href="{{ path('app_shop_index') }}">Store</a></li>
            {% endif %}
        </ul>
        </div>

        <div class="footer-section contact">
        <h4>Contact</h4>
        <p>Email: elgoureissmail@gmail.com</p>
        <p>Phone: +212 770-010789</p>
        <div class="social-icons">
            <a href="https://www.instagram.com/0__i__s__m__a__i__l__0/" target="blank"><i class="bi bi-instagram"></i></a>
            <a href="https://github.com/ismailel06" target="blank"><i class="bi bi-github"></i></a>
            <a href="https://www.linkedin.com/in/ismail-elgoure-619195310/" target="blank"><i class="bi bi-linkedin" target="blank"></i></a>
        </div>
        </div>
        </div>

        <div class="footer-bottom">
        &copy; 2025 FlowVentory. All rights reserved.
        </div>
</footer>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
</body>
</html>
