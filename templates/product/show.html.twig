{% extends 'base.html.twig' %}

{% block title %}Product Details{% endblock %}

{% block body %}

{% set imgPath = product.imageName
    ? asset('uploads/products/' ~ product.imageName)
    : asset('images/product-placeholder.jpg')
%}

<div class="card shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-0">Product Details</h5>
            <div class="text-muted small">{{ product.serialNumber }}</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_product_index') }}">
                <i class="fa-solid fa-arrow-left me-1"></i> Back
            </a>

            <a class="btn btn-warning btn-sm" href="{{ path('app_product_edit', {'id': product.id}) }}">
                <i class="fas fa-pen-to-square me-1"></i> Edit
            </a>

            {{ include('product/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="product-show-img shadow-sm">
                <img src="{{ imgPath }}" alt="{{ product.name }}">
            </div>

            {% set qty = product.quantity %}
            {% if qty > 3 %}
                <div class="mt-3 badge bg-success p-2 w-100 text-center">In Stock</div>
            {% elseif qty > 0 %}
                <div class="mt-3 badge bg-warning text-dark p-2 w-100 text-center">Low Stock</div>
            {% else %}
                <div class="mt-3 badge bg-danger p-2 w-100 text-center">Out of Stock</div>
            {% endif %}
        </div>

        <div class="col-lg-8">
            <div class="table-responsive bg-white shadow-sm rounded">
                <table class="table mb-0">
                    <tbody>
                        <tr>
                            <th style="width: 200px;">Name</th>
                            <td class="fw-semibold">{{ product.name }}</td>
                        </tr>
                        <tr>
                            <th>Category</th>
                            <td>{{ product.category }}</td>
                        </tr>
                        <tr>
                            <th>Supplier</th>
                            <td>{{ product.supplier ? product.supplier.name : '-' }}</td>
                        </tr>
                        <tr>
                            <th>Price</th>
                            <td>${{ product.price }}</td>
                        </tr>
                        <tr>
                            <th>Quantity</th>
                            <td>{{ product.quantity }}</td>
                        </tr>
                        <tr>
                            <th>Image file</th>
                            <td>
                                {% if product.imageName %}
                                    <span class="text-muted">{{ product.imageName }}</span>
                                {% else %}
                                    <span class="text-muted">default_product.jpg</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Created</th>
                            <td>{{ product.createdAt ? product.createdAt|date('Y-m-d H:i') : '-' }}</td>
                        </tr>
                        <tr>
                            <th>Updated</th>
                            <td>{{ product.updatedAt ? product.updatedAt|date('Y-m-d H:i') : '-' }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mt-3 text-muted small">
                Product ID: #{{ product.id }}
            </div>
        </div>
    </div>
</div>

{% endblock %}
