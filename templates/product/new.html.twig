{% extends 'base.html.twig' %}

{% block title %}New Product{% endblock %}

{% block body %}

<div class="card shadow-sm p-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h5 class="mb-0">Add Product</h5>
      <div class="text-muted small">Create a new product and upload an image.</div>
    </div>

    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_product_index') }}">
      <i class="fa-solid fa-arrow-left me-1"></i> Back
    </a>
  </div>

  {{ include('product/_form.html.twig', { button_label: 'Save Product' }) }}
</div>

{% endblock %}
