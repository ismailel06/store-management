{{ form_start(form, { attr: { enctype: 'multipart/form-data' } }) }}

<div class="row g-3">
  <div class="col-md-8">
    {{ form_label(form.name) }}
    {{ form_widget(form.name, { attr: { class: 'form-control', placeholder: 'Product name' } }) }}
    {{ form_errors(form.name) }}
  </div>

  <div class="col-md-4">
    {{ form_label(form.category) }}
    {{ form_widget(form.category, { attr: { class: 'form-select' } }) }}
    {{ form_errors(form.category) }}
  </div>

  <div class="col-md-4">
    {{ form_label(form.price) }}
    {{ form_widget(form.price, { attr: { class: 'form-control', placeholder: 'Price' } }) }}
    {{ form_errors(form.price) }}
  </div>

  <div class="col-md-4">
    {{ form_label(form.quantity) }}
    {{ form_widget(form.quantity, { attr: { class: 'form-control', min: 0 } }) }}
    {{ form_errors(form.quantity) }}
  </div>

  <div class="col-md-6">
    {{ form_label(form.supplier) }}
    {{ form_widget(form.supplier, { attr: { class: 'form-select' } }) }}
    {{ form_errors(form.supplier) }}
  </div>

  <div class="col-md-6">
    <label class="form-label">Product image</label>

    <div class="upload-box p-3">
      {{ form_widget(form.imageFile, { attr: { class: 'form-control' } }) }}
      <div class="text-muted small mt-2">
        Allowed: JPG / PNG / WebP • Max: 2MB
      </div>
      {{ form_errors(form.imageFile) }}
    </div>
  </div>

</div>

<hr class="my-4">

<div class="d-flex justify-content-end gap-2">
  <a class="btn btn-outline-secondary" href="{{ path('app_product_index') }}">
    Cancel
  </a>

  <button class="btn btn-primary">
    <i class="fa-solid fa-floppy-disk me-1"></i> {{ button_label|default('Save') }}
  </button>
</div>

{{ form_end(form) }}
