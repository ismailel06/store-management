{% extends 'base.html.twig' %}
{% block title %}Login{% endblock %}

{% block body %}
<div class="auth-wrap">
  <div class="card shadow-sm p-4 p-md-5 auth-card">
    <div class="text-center mb-4">
      <div class="auth-logo mb-2">
        <i class="bi bi-bag-check-fill"></i>
      </div>
      <h4 class="mb-1">Welcome back</h4>
      <div class="text-muted">Login to continue</div>
    </div>

    {% if error %}
      <div class="alert alert-danger">
        {{ error.messageKey|trans(error.messageData, 'security') }}
      </div>
    {% endif %}

    <form method="post" action="{{ path('app_login')}}" class="auth-form">
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email"
               name="_username"
               value="{{ last_username }}"
               class="form-control form-control-lg"
               autocomplete="email"
               required autofocus>
      </div>

      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password"
               name="_password"
               class="form-control form-control-lg"
               autocomplete="current-password"
               required>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="_remember_me" id="remember_me">
          <label class="form-check-label" for="remember_me">Remember me</label>
        </div>

        <a class="small text-decoration-none" href="{{ path('app_register') }}">Create account</a>
      </div>

      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

      <button class="btn btn-primary w-100 btn-lg" type="submit">
        <i class="bi bi-box-arrow-in-right me-1"></i> Login
      </button>
    </form>
  </div>
</div>
{% endblock %}