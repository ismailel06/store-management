{% extends 'base.html.twig' %}
{% block title %}Checkout{% endblock %}

{% block body %}

{% for label, messages in app.flashes %}
  {% for message in messages %}
    <div class="alert alert-{{ label }} mb-3">{{ message }}</div>
  {% endfor %}
{% endfor %}

<div class="card shadow-sm p-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Checkout</h5>
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cart_index') }}">
      <i class="fa-solid fa-arrow-left me-1"></i> Back to cart
    </a>
  </div>

  <div class="table-responsive bg-white shadow-sm rounded">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>Product</th>
          <th class="text-center" style="width:120px;">Qty</th>
          <th class="text-center" style="width:140px;">Unit Price</th>
          <th class="text-center" style="width:140px;">Total</th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
          <tr>
            <td class="fw-semibold">{{ item.product.name }}</td>
            <td class="text-center">{{ item.qty }}</td>
            <td class="text-center">${{ item.product.price }}</td>
            <td class="text-center fw-semibold">${{ item.lineTotal|number_format(2, '.', ',') }}</td>
          </tr>
        {% else %}
          <tr>
            <td colspan="4" class="text-center text-muted py-4">Your cart is empty.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="d-flex justify-content-between align-items-center mt-4">
    <div class="fw-semibold fs-5">
      Total: ${{ total|number_format(2, '.', ',') }}
    </div>

    <form method="post" action="{{ path('app_checkout_place') }}">
      <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">
      <button class="btn btn-primary {% if items is empty %}disabled{% endif %}" type="submit">
        <i class="bi bi-credit-card me-1"></i> Place Order
      </button>
    </form>
  </div>
</div>

{% endblock %}
