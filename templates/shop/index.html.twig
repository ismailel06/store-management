{% extends 'base.html.twig' %}
{% block title %}Shop{% endblock %}

{% block body %}

{% for label, messages in app.flashes %}
  {% for message in messages %}
    <div class="alert alert-{{ label }} mb-3">{{ message }}</div>
  {% endfor %}
{% endfor %}

<div class="card shadow-sm p-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Shop Products</h5>
    <a class="btn btn-outline-primary btn-sm" href="{{ path('app_cart_index') }}">
      <i class="bi bi-cart3 me-1"></i> View Cart
    </a>
  </div>

  <div class="row g-3">
    {% for product in products %}
      {% set imgPath = product.imageName
        ? asset('uploads/products/' ~ product.imageName)
        : asset('images/product-placeholder.jpg')
      %}

      {% set qtyText = 'Available' %}
      {% set qty = product.quantity %}
      {% if qty > 3 %}
        {% set qtyBadge = 'bg-success' %}
      {% elseif qty > 0 %}
        {% set qtyBadge = 'bg-warning text-dark' %}
      {% else %}
        {% set qtyBadge = 'bg-danger' %}
      {% endif %}

      <div class="col-md-4 col-lg-3">
        <div class="card h-100 shadow-sm product-card" id="shop-cards">
          <div class="product-card-img">
            <img src="{{ imgPath }}" alt="{{ product.name }}" class="w-100 h-100 rounded">
          </div>

          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start">
              <div class="me-2">
                <h6 class="card-title mb-1 text-truncate">{{ product.name }}</h6>
                <div class="text-muted small text-truncate">{{ product.category }}</div>
              </div>
              <div class="fw-semibold d-flex flex-column">
                ${{ product.price }}
                <span class="badge {{ qtyBadge }} product-badge">
                  {{ qtyText }} • {{ qty }}
                </span>
              </div>
              
            </div>

            <div class="mt-auto pt-3">
              {% if qty == 0 %}
                <button class="btn btn-secondary w-100" disabled>
                  <i class="bi bi-cart-x me-1"></i> Out of Stock
                </button>
              {% else %}
                <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}" class="d-flex gap-2">
                  <input class="form-control" type="number" name="qty" min="1" value="1" style="max-width:90px;">
                  <button class="btn btn-primary w-100" type="submit">
                    <i class="bi bi-cart-plus me-1"></i> Add
                  </button>
                </form>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% else %}
      <div class="text-muted">No products.</div>
    {% endfor %}
  </div>
</div>

{% endblock %}
