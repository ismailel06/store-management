{{ form_start(form) }}

<div class="mb-3">
    {{ form_label(form.name) }}
    {{ form_widget(form.name, { attr: { class: 'form-control', placeholder: 'Supplier name' } }) }}
    {{ form_errors(form.name) }}
</div>

<button class="btn btn-primary">
    <i class="fa-solid fa-floppy-disk me-1"></i> {{ button_label|default('Save') }}
</button>

<a class="btn btn-outline-secondary ms-2" href="{{ path('app_supplier_index') }}">
    Cancel
</a>

{{ form_end(form) }}
