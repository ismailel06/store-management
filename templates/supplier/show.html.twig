{% extends 'base.html.twig' %}

{% block title %}Supplier Details{% endblock %}

{% block body %}

<div class="card shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-0">Supplier Details</h5>
            <div class="text-muted small">Supplier ID: #{{ supplier.id }}</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_supplier_index') }}">
                <i class="fa-solid fa-arrow-left me-1"></i> Back
            </a>

            <a class="btn btn-warning btn-sm" href="{{ path('app_supplier_edit', {'id': supplier.id}) }}">
                <i class="fas fa-pen-to-square me-1"></i> Edit
            </a>
        </div>
    </div>

    <div class="table-responsive bg-white shadow-sm rounded">
        <table class="table mb-0">
            <tbody>
                <tr>
                    <th style="width: 200px;">Name</th>
                    <td class="fw-semibold">{{ supplier.name }}</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
